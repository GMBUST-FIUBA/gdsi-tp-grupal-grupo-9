# Postgres. En local podes usar la "External Database URL" que te da Render,
# asi no hace falta instalar nada.
DATABASE_URL=postgres://usuario:clave@host:5432/galeria
PORT=3000
# Firma la cookie de sesion. En local puede quedar vacio; en Render lo genera el Blueprint.
SESSION_SECRET=

# URL publica de la app, para armar los links de acceso que van por mail.
# Si falta, se deduce del pedido.
APP_URL=http://localhost:3000

# Servidor SMTP para mandar la rendicion por mail. Sin esto, el boton
# "Enviar al dueño" queda deshabilitado y el resto de la app anda igual.
# Gmail: usar una "contraseña de aplicacion", no la del usuario.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usuario@gmail.com
SMTP_PASS=contrasena-de-aplicacion
SMTP_FROM=Galex <usuario@gmail.com>
