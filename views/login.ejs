<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Galex - Ingresar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/layout.css">
<style>
  .login-wrap{min-height:100vh;display:grid;place-items:center;padding:24px}
  .login-card{width:100%;max-width:380px}
  .login-brand{display:flex;align-items:center;gap:12px;margin-bottom:22px}
  .login-brand .plaque{width:44px;height:44px;border-radius:9px;background:linear-gradient(160deg,#dcae5f,#a06d2b);
    display:grid;place-items:center;font-family:'Bricolage Grotesque';font-weight:800;color:#2a1e08;font-size:1.05rem}
  .login-brand h1{margin:0;font-size:1.4rem}
  .login-brand .sub{font-size:.78rem;color:var(--muted)}
  .login-card .field{margin-bottom:14px}
  .login-card .btn{width:100%;justify-content:center;margin-top:6px}
</style>
</head>
<body>
<div class="login-wrap">
  <div class="panel login-card">
    <div class="panel-body">
      <div class="login-brand">
        <div class="plaque">GX</div>
        <div><h1>Galex</h1><div class="sub">Gestión de locales comerciales</div></div>
      </div>

      <form method="post" action="/login">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autofocus value="<%= email %>" placeholder="tu@correo.com">
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" required>
        </div>
        <% if (error) { %>
          <div class="note late" style="margin-bottom:12px"><%= error %></div>
        <% } %>
        <button class="btn btn-primary" type="submit">Ingresar</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
