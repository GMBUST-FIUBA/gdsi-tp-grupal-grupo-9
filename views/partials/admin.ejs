<!-- ============ ADMIN ============ -->
<main class="wrap view" id="view-admin" role="tabpanel" aria-labelledby="tab-admin"<%= (typeof oculto !== "undefined" && oculto) ? " hidden" : "" %>>
  <nav class="section-nav" role="tablist" aria-label="Secciones de administración">
    <button role="tab" aria-selected="true"  aria-controls="sec-panel"  id="sec-tab-panel"  onclick="setSection('panel')">Panel general</button>
    <button role="tab" aria-selected="false" aria-controls="sec-gastos" id="sec-tab-gastos" onclick="setSection('gastos')">Gastos</button>
    <button role="tab" aria-selected="false" aria-controls="sec-cuenta" id="sec-tab-cuenta" onclick="setSection('cuenta')">Estado de cuenta</button>
    <button role="tab" aria-selected="false" aria-controls="sec-duenos" id="sec-tab-duenos" onclick="setSection('duenos')">Dueños</button>
    <button role="tab" aria-selected="false" aria-controls="sec-config" id="sec-tab-config" onclick="setSection('config')">Configuración</button>
    <button role="tab" aria-selected="false" aria-controls="sec-mensajes" id="sec-tab-mensajes" onclick="setSection('mensajes')">Mensajes</button>
  </nav>

  <div id="sec-panel" role="tabpanel" aria-labelledby="sec-tab-panel">
  <div class="page-head">
    <span class="eyebrow">Panel del administrador · <%= periodoLabel %></span>
    <h1>Ocupación y cobranzas</h1>
    <p>Tocá un local para ver su contrato, la liquidación, el comprobante subido y el estado de pago.</p>
  </div>

  <section class="kpis" aria-label="Resumen del mes">
    <div class="kpi accent-ok"><div class="k-label">Ocupación</div><div class="k-value" id="kpi-occ">—</div><div class="k-foot" id="kpi-occ-foot"></div></div>
    <div class="kpi"><div class="k-label">Facturado del mes</div><div class="k-value mono" id="kpi-fact">—</div><div class="k-foot">Alquileres + gastos comunes</div></div>
    <div class="kpi accent-ok"><div class="k-label">Cobrado</div><div class="k-value mono" id="kpi-cob">—</div><div class="k-foot" id="kpi-cob-foot"></div></div>
    <div class="kpi accent-late"><div class="k-label">En mora</div><div class="k-value mono" id="kpi-mora">—</div><div class="k-foot" id="kpi-mora-foot"></div></div>
  </section>

  <section class="board-card" aria-label="Plano de la galería">
    <div class="board-head">
      <h2>Plano de la galería</h2>
      <div class="legend">
        <span><i class="i-ok"></i> Al día</span><span><i class="i-warn"></i> Por vencer</span>
        <span><i class="i-late"></i> En mora</span><span><i class="i-free"></i> Libre</span>
      </div>
    </div>
    <div class="plan" id="plan"></div>
  </section>

  <div class="cols">
    <section class="panel" aria-live="polite">
      <div class="panel-head"><h3>Detalle del local</h3><span class="sub" id="detail-sub">Seleccioná un local</span></div>
      <div class="panel-body" id="detail-body">
        <div class="empty"><span class="big">↑</span>Tocá un local del plano para ver su contrato y liquidación.</div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-body">
        <div class="tabs" role="tablist" aria-label="Gestión">
          <button role="tab" aria-selected="true"  aria-controls="tp-contrato"  id="t-contrato"  onclick="setTab('contrato')">Nuevo contrato</button>
          <button role="tab" aria-selected="false" aria-controls="tp-cobranzas" id="t-cobranzas" onclick="setTab('cobranzas')">Cobranzas</button>
          <button role="tab" aria-selected="false" aria-controls="tp-locatarios" id="t-locatarios" onclick="setTab('locatarios')">Locatarios</button>
          <button role="tab" aria-selected="false" aria-controls="tp-config"    id="t-config"    onclick="setTab('config')">Configuración</button>
        </div>

        <!-- Nuevo contrato -->
        <div class="tabpane" id="tp-contrato" role="tabpanel" aria-labelledby="t-contrato">
          <div class="form-grid">
            <div class="field"><label for="f-local">Local</label><select id="f-local"></select></div>
            <div class="field"><label for="f-rubro">Rubro</label><input id="f-rubro" placeholder="Indumentaria, gastronomía…"></div>
            <div class="field full"><label for="f-locatario">Locatario</label><input id="f-locatario" placeholder="Razón social o nombre"></div>
            <div class="field"><label for="f-email">Email</label><input id="f-email" type="email" placeholder="correo@ejemplo.com"></div>
            <div class="field"><label for="f-tel">Teléfono</label><input id="f-tel" placeholder="+54 11 ..."></div>
            <div class="field full">
              <label class="check-line" for="f-dueno">
                <input type="checkbox" id="f-dueno" onchange="syncEsDueno()">
                <span>El locatario es el dueño del local</span>
              </label>
              <span class="hint">No se le cobra alquiler: solo las expensas de los gastos extraordinarios.</span>
            </div>
            <div class="field"><label for="f-desde">Inicio</label><input id="f-desde" type="date" value="2026-09-01"></div>
            <div class="field"><label for="f-meses">Plazo (meses)</label><input id="f-meses" type="number" value="24" min="1"></div>
            <div class="field" id="f-fijo-wrap"><label for="f-fijo">Alquiler fijo mensual</label><input id="f-fijo" value="$ 620.000,00"></div>
            <div class="field" id="f-modo-wrap"><label for="f-modo">Modalidad</label>
              <select id="f-modo" onchange="syncModalidad()">
                <option value="fijo">Fijo</option>
                <option value="fijo_pct">Fijo + % de facturación</option>
              </select></div>
            <div class="field" id="f-pct-wrap" hidden><label for="f-pct">% de facturación</label>
              <div class="suffix-wrap"><input id="f-pct" type="number" min="0" step="0.01" value="4"><span class="sfx">%</span></div></div>
            <div class="field full"><label>Contrato firmado (PDF)</label>
              <label class="filebox" for="f-pdf" id="f-pdf-box">
                <div class="fi-ico">📄</div><div class="fi-t" id="f-pdf-t">Subir contrato firmado</div><div class="fi-s">PDF · hasta 10 MB</div>
              </label>
              <input type="file" id="f-pdf" accept="application/pdf" onchange="fileChosen(this,'f-pdf-box','f-pdf-t','Contrato cargado')">
            </div>
          </div>
          <div class="note">La modalidad y el índice definido en <strong>Configuración</strong> determinan cómo se recalcula la liquidación en cada actualización.</div>
          <div class="note late" id="f-err" hidden></div>
          <div class="form-actions">
            <%# TODO: guardar borrador necesita un estado 'borrador' en Contrato; hoy solo se registra el contrato completo. %>
            <button class="btn btn-ghost" onclick="replicarUltimoContrato()">Replicar último contrato</button>
            <button class="btn btn-ghost" onclick="toast('Guardar borrador todavía no está implementado')">Guardar borrador</button>
            <button class="btn btn-primary" onclick="registrarContrato()">Registrar contrato</button>
          </div>
        </div>

        <!-- Cobranzas -->
        <div class="tabpane" id="tp-cobranzas" role="tabpanel" aria-labelledby="t-cobranzas" hidden>
          <div class="rows" id="cobr-rows"></div>
          <div class="form-actions">
            <%# TODO: ambas acciones necesitan mailer y el cálculo de mora por vencimiento. %>
            <button class="btn btn-ghost" onclick="toast('Envío de recordatorios todavía no está implementado')">Enviar recordatorios</button>
            <button class="btn btn-primary" onclick="toast('Aplicación de interés todavía no está implementada')">Aplicar interés</button>
          </div>
        </div>

        <!-- Locatarios (ABM) -->
        <div class="tabpane" id="tp-locatarios" role="tabpanel" aria-labelledby="t-locatarios" hidden>
          <div class="note">El alta de un locatario se hace al registrar su contrato, para que quede asociado a un local y a una liquidación.</div>
          <div class="form-actions" style="margin-top:12px"><button class="btn btn-primary btn-sm" onclick="setTab('contrato')">Ir a nuevo contrato</button></div>
          <div class="abm" id="abm-list" style="margin-top:8px"></div>
        </div>

        <!-- Configuración de la galería -->
        <div class="tabpane" id="tp-config" role="tabpanel" aria-labelledby="t-config" hidden>
          <% var cfg = estado.config || {}; %>
          <div class="form-grid">
            <div class="field"><label for="c-indice">Índice de actualización</label>
              <select id="c-indice">
                <% ['ICL (BCRA)', 'IPC', 'Casa Propia', 'Escalonado pactado'].forEach(function (o) { %>
                  <option<%= cfg.indice === o ? ' selected' : '' %>><%= o %></option>
                <% }); %>
              </select></div>
            <div class="field"><label for="c-frec">Frecuencia de actualización</label>
              <select id="c-frec">
                <% ['Trimestral', 'Cuatrimestral', 'Semestral', 'Anual'].forEach(function (o) { %>
                  <option<%= cfg.frecuencia === o ? ' selected' : '' %>><%= o %></option>
                <% }); %>
              </select></div>
            <div class="field"><label for="c-mora">Interés por mora</label>
              <div class="suffix-wrap"><input id="c-mora" value="<%= String(cfg.interesMoraDiario || 0).replace('.', ',') %>"><span class="sfx">% por mes</span></div>
              <span class="hint">Se cobra por cada mes de atraso sobre el monto de cada mes adeudado.</span></div>
            <div class="field"><label for="c-comision">Comisión del administrador</label>
              <div class="suffix-wrap"><input id="c-comision" value="<%= String(cfg.comisionAdmin || 0).replace('.', ',') %>"><span class="sfx">% cobrado</span></div>
              <span class="hint">Se liquida solo sobre lo efectivamente cobrado.</span></div>
            <div class="field"><label for="c-venc">Día de vencimiento mensual</label><input id="c-venc" type="number" value="<%= cfg.diaVencimiento || 10 %>" min="1" max="28"></div>
            <div class="field"><label for="c-gracia">Días de gracia</label><input id="c-gracia" type="number" value="<%= cfg.diasGracia || 0 %>" min="0"></div>
          </div>
          <div class="note">Estos parámetros se aplican a todas las liquidaciones de la galería a partir del próximo cierre. Las expensas de cada local salen de repartir los gastos del mes según su porcentaje (sección <strong>Configuración</strong>).</div>
          <div class="note late" id="c-err" hidden></div>
          <div class="form-actions"><button class="btn btn-primary" onclick="guardarParametros()">Guardar configuración</button></div>
        </div>

      </div>
    </section>
  </div>

  <!-- Historial -->
  <div class="section-title"><h2>Historial</h2><span class="st-sub">Cierres mensuales y estado de cuenta por local</span></div>
  <section class="panel hist-tables">
    <div class="panel-body">
      <div class="tabs" role="tablist" aria-label="Historial">
        <button role="tab" aria-selected="true"  aria-controls="hp-mes"   id="h-mes"   onclick="setHist('mes')">Cierre del mes</button>
        <button role="tab" aria-selected="false" aria-controls="hp-local" id="h-local" onclick="setHist('local')">Cierre por local (estado de cuenta)</button>
      </div>

      <div class="tabpane" id="hp-mes" role="tabpanel" aria-labelledby="h-mes">
        <table class="data">
          <thead><tr><th>Período</th><th class="r">Facturado</th><th class="r">Cobrado</th><th class="r">Mora</th><th class="r">Comisión</th><th class="r">Neto al dueño</th><th class="r">Estado</th></tr></thead>
          <tbody id="hist-rows"></tbody>
        </table>
      </div>

      <div class="tabpane" id="hp-local" role="tabpanel" aria-labelledby="h-local" hidden>
        <table class="data">
          <thead><tr><th>Local</th><th>Locatario</th><th class="r">Facturado</th><th class="r">Cobrado</th><th class="r">Saldo</th><th class="r">Estado</th></tr></thead>
          <tbody id="acct-rows"></tbody>
        </table>
      </div>
    </div>
  </section>
  </div>

  <div id="sec-gastos" role="tabpanel" aria-labelledby="sec-tab-gastos" hidden>
    <div class="page-head">
      <span class="eyebrow">Gestión de gastos</span>
      <h1>Gastos ordinarios y extraordinarios</h1>
      <p>Cargá, editá o borrá los gastos de la galería. Los locatarios los ven reflejados en su cuenta, incluida la factura adjunta.</p>
    </div>

    <section class="panel">
      <div class="panel-head"><h3>Cargar gasto</h3></div>
      <div class="panel-body">
        <div class="form-grid">
          <div class="field"><label for="g-tipo">Tipo de gasto</label>
            <select id="g-tipo"><option value="ordinario">Ordinario</option><option value="extraordinario">Extraordinario</option></select></div>
          <div class="field"><label for="g-prov">Proveedor</label>
            <select id="g-prov"></select></div>
          <div class="field"><label for="g-facttipo">Tipo de factura</label><select id="g-facttipo"></select></div>
          <div class="field"><label for="g-factnro">Número de factura</label><input id="g-factnro" placeholder="0001-00001234"></div>
          <div class="field full"><label for="g-desc">Descripción</label><input id="g-desc" placeholder="Ej. Consumo eléctrico de agosto"></div>
          <div class="field"><label for="g-monto">Costo</label><input id="g-monto" type="number" min="0" step="0.01" placeholder="0,00"><span class="hint">Hasta dos decimales.</span></div>
          <div class="field full"><label>Factura (PDF, JPEG o PNG) · opcional</label>
            <label class="filebox" for="g-archivo" id="g-archivo-box">
              <div class="fi-ico">📎</div><div class="fi-t" id="g-archivo-t">Adjuntar factura</div><div class="fi-s">PDF, JPEG o PNG · opcional</div>
            </label>
            <input type="file" id="g-archivo" accept="application/pdf,image/jpeg,image/png" onchange="fileChosen(this,'g-archivo-box','g-archivo-t','Factura adjuntada')">
          </div>
        </div>
        <div class="note late" id="g-err" hidden></div>
        <div class="form-actions"><button class="btn btn-primary" onclick="addGasto()">Agregar gasto</button></div>
      </div>
    </section>

    <div class="section-title"><h2>Gastos cargados</h2><span class="st-sub" id="gastos-count"></span></div>
    <section class="panel"><div class="panel-body">
      <div class="abm" id="gastos-list"></div>
    </div></section>
  </div>

  <div id="sec-cuenta" role="tabpanel" aria-labelledby="sec-tab-cuenta" hidden>
    <div class="page-head">
      <span class="eyebrow">Estado de cuenta · <%= periodoLabel %></span>
      <h1>Gastos, ingresos y saldo del mes</h1>
      <p>Resumen del mes en curso. Al liquidar las expensas el mes se cierra: los gastos se reparten entre los locales según su porcentaje y lo que queda en la cuenta pasa como saldo anterior del mes siguiente.</p>
    </div>

    <section class="kpis" aria-label="Estado de cuenta del mes">
      <div class="kpi"><div class="k-label">Saldo anterior</div><div class="k-value mono" id="cta-ant">—</div><div class="k-foot" id="cta-ant-foot"></div></div>
      <div class="kpi accent-late"><div class="k-label">Gastos del mes</div><div class="k-value mono" id="cta-gastos">—</div><div class="k-foot" id="cta-gastos-foot"></div></div>
      <div class="kpi accent-ok"><div class="k-label">Ingresos del mes</div><div class="k-value mono" id="cta-ing">—</div><div class="k-foot" id="cta-ing-foot"></div></div>
      <div class="kpi"><div class="k-label">Saldo en la cuenta</div><div class="k-value mono" id="cta-saldo">—</div><div class="k-foot">Saldo anterior + ingresos − gastos</div></div>
    </section>

    <div class="cols">
      <section class="panel">
        <div class="panel-head"><h3>Gastos</h3><span class="sub" id="cta-gastos-sub"></span></div>
        <div class="panel-body" id="cta-gastos-body"></div>
      </section>
      <section class="panel">
        <div class="panel-head"><h3>Ingresos</h3><span class="sub">Pagos aceptados de los locatarios</span></div>
        <div class="panel-body" id="cta-ing-body"></div>
      </section>
    </div>

    <section class="panel" style="margin-top:20px">
      <div class="panel-head"><h3>Estado de cuenta</h3><span class="sub"><%= periodoLabel %></span></div>
      <div class="panel-body">
        <div class="rend" id="cta-resumen"></div>
        <div id="cta-saldo-inicial"></div>
        <div class="form-actions"><button class="btn btn-primary" id="cta-liquidar" onclick="abrirLiquidar()">Liquidar expensas</button></div>
      </div>
    </section>

    <section class="panel" id="liq-panel" style="margin-top:20px" hidden>
      <div class="panel-head"><h3>Liquidar expensas · <%= periodoLabel %></h3><span class="sub" id="liq-sub"></span></div>
      <div class="panel-body">
        <div class="rend" id="liq-resumen"></div>
        <div id="liq-aumentos"></div>
        <div id="liq-avisos"></div>
        <h3 style="margin:20px 0 10px;font-size:1rem" id="liq-tabla-titulo"></h3>
        <div style="overflow-x:auto">
          <table class="data">
            <thead><tr><th>Local</th><th>Locatario</th><th class="r">Alquiler</th><th class="r">Expensas</th><th class="r">Deuda anterior</th><th class="r">Punitorios</th><th class="r">Total</th></tr></thead>
            <tbody id="liq-rows"></tbody>
          </table>
        </div>
        <div class="note late" id="liq-err" hidden></div>
        <div class="form-actions">
          <button class="btn btn-ghost" onclick="cerrarLiquidar()">Cancelar</button>
          <button class="btn btn-primary" id="liq-confirmar" onclick="confirmarCierre()">Confirmar</button>
        </div>
      </div>
    </section>

    <div class="section-title"><h2>Meses liquidados</h2><span class="st-sub" id="cta-cierres-count"></span></div>
    <section class="panel"><div class="panel-body" style="overflow-x:auto" id="cta-cierres"></div></section>
  </div>

  <div id="sec-config" role="tabpanel" aria-labelledby="sec-tab-config" hidden>
    <div class="page-head">
      <span class="eyebrow">Configuración</span>
      <h1>Expensas por comercio</h1>
      <p>Definí qué porcentaje de las expensas le corresponde a cada comercio. La suma de todos los porcentajes no puede superar el 100%.</p>
    </div>

    <section class="panel">
      <div class="panel-head"><h3>Porcentaje de expensas</h3></div>
      <div class="panel-body">
        <div class="form-grid">
          <div class="field"><label for="cf-unidad">Comercio</label>
            <select id="cf-unidad" onchange="syncConfigPct()"></select></div>
          <div class="field"><label for="cf-pct">Porcentaje de expensas</label>
            <div class="suffix-wrap"><input id="cf-pct" inputmode="decimal" placeholder="0,00"><span class="sfx">%</span></div>
            <span class="hint">Hasta dos decimales. Si el comercio ya tiene un porcentaje, se reemplaza.</span></div>
        </div>
        <div class="note late" id="cf-err" hidden></div>
        <div class="form-actions"><button class="btn btn-primary" onclick="setPorcentajeExpensa()">Asignar porcentaje</button></div>
      </div>
    </section>

    <div class="section-title"><h2>Porcentajes asignados</h2><span class="st-sub" id="cf-total"></span></div>
    <section class="panel"><div class="panel-body">
      <div class="abm" id="cf-list"></div>
    </div></section>

    <div class="section-title"><h2>Ajuste de expensas del mes</h2></div>
    <section class="panel">
      <div class="panel-head"><h3>Descuento o cargo adicional</h3></div>
      <div class="panel-body">
        <div class="form-grid">
          <div class="field"><label for="aj-unidad">Comercio</label>
            <select id="aj-unidad" onchange="syncAjuste()"></select>
            <span class="hint" id="aj-base"></span></div>
          <div class="field"><label for="aj-tipo">Tipo de ajuste</label>
            <select id="aj-tipo"><option value="descuento">Descuento</option><option value="cargo">Cargo adicional</option></select></div>
          <div class="field"><label for="aj-monto">Monto</label>
            <input id="aj-monto" type="number" min="0" step="0.01" placeholder="0,00">
            <span class="hint">Hasta dos decimales. El descuento no puede superar las expensas del comercio.</span></div>
          <div class="field"><label for="aj-motivo">Motivo (opcional)</label>
            <input id="aj-motivo" maxlength="120" placeholder="Ej.: bonificación por obra en el pasillo"></div>
        </div>
        <div class="field"><span class="hint">Aplica solo a la liquidación del mes actual. Si el comercio ya tiene un ajuste, se reemplaza.</span></div>
        <div class="note late" id="aj-err" hidden></div>
        <div class="form-actions"><button class="btn btn-primary" onclick="setAjusteExpensas()">Aplicar ajuste</button></div>
      </div>
    </section>

    <div class="section-title"><h2>Ajustes aplicados</h2><span class="st-sub" id="aj-count"></span></div>
    <section class="panel"><div class="panel-body">
      <div class="abm" id="aj-list"></div>
    </div></section>
  </div>

  <div id="sec-duenos" role="tabpanel" aria-labelledby="sec-tab-duenos" hidden>
    <div class="page-head">
      <span class="eyebrow">Dueños</span>
      <h1>Propietarios de los locales</h1>
      <p>Cada local de la galería pertenece a un dueño. Elegí uno para ver su rendición del mes y sus datos.</p>
    </div>

    <section class="panel">
      <div class="panel-body">
        <div class="du-barra">
          <div class="field"><label for="du-sel">Dueño</label>
            <select id="du-sel" onchange="seleccionarDueno(this.value)"></select></div>
          <button class="btn btn-primary" id="du-nuevo-btn" onclick="abrirAltaDueno()">Agregar dueño</button>
        </div>
        <div class="note" id="du-sin-dueno" hidden></div>
      </div>
    </section>

    <%# Alta de un dueño: arranca colapsada, se abre con "Agregar dueño". %>
    <section class="panel" id="du-alta" hidden>
      <div class="panel-head"><h3>Nuevo dueño</h3></div>
      <div class="panel-body">
        <div class="form-grid">
          <div class="field full"><label for="na-nombre">Nombre / razón social</label>
            <input id="na-nombre" placeholder="Nombre del propietario"></div>
          <div class="field"><label for="na-email">Email</label>
            <input id="na-email" type="email" placeholder="correo@ejemplo.com"></div>
          <div class="field"><label for="na-tel">Teléfono</label>
            <input id="na-tel" placeholder="+54 11 ..."></div>
          <div class="field full"><label for="na-contacto">Otros datos de contacto</label>
            <input id="na-contacto" maxlength="200" placeholder="Dirección, CBU, notas..."></div>
          <div class="field full"><label>Locales de la galería</label>
            <div class="check-grid" id="na-locales"></div>
            <span class="hint">Solo se pueden asignar locales sin dueño. Para pasarle uno que ya tiene dueño, quitáselo primero desde la ficha de ese dueño.</span></div>
        </div>
        <div class="note late" id="na-err" hidden></div>
        <div class="form-actions">
          <button class="btn btn-ghost" onclick="cerrarAltaDueno()">Cancelar</button>
          <button class="btn btn-primary" onclick="crearDueno()">Guardar dueño</button>
        </div>
      </div>
    </section>

    <div class="section-title"><h2>Rendición de cuentas</h2><span class="st-sub"><%= periodoLabel %></span></div>
    <section class="panel">
      <div class="panel-head"><h3 id="rend-titulo">Resumen del mes</h3><span class="sub" id="rend-sub"></span></div>
      <div class="panel-body">
        <div class="rend" id="rend-lines"></div>
        <div class="note late" id="rend-err" hidden></div>
        <div class="form-actions">
          <button class="btn btn-ghost" onclick="descargarRendicion()">Descargar PDF</button>
          <button class="btn btn-primary" id="rend-enviar" onclick="enviarRendicion()">Enviar al dueño</button>
        </div>
      </div>
    </section>

    <%# Datos del dueño elegido: se leen, y "Editar" los vuelve editables. %>
    <div class="section-title" id="du-datos-titulo" hidden><h2>Datos del dueño</h2></div>
    <section class="panel" id="du-datos" hidden>
      <div class="panel-head"><h3 id="du-datos-nombre">—</h3><span class="sub" id="du-datos-sub"></span></div>
      <div class="panel-body">
        <div id="du-ver">
          <dl class="dl" id="du-ver-dl"></dl>
          <div class="form-actions">
            <button class="btn btn-danger btn-sm" onclick="confirmBorrarDueno()">Borrar dueño</button>
            <button class="btn btn-primary" onclick="habilitarEdicionDueno()">Editar</button>
          </div>
        </div>

        <div id="du-editar" hidden>
          <div class="form-grid">
            <div class="field full"><label for="du-nombre">Nombre / razón social</label>
              <input id="du-nombre" placeholder="Nombre del propietario"></div>
            <div class="field"><label for="du-email">Email</label>
              <input id="du-email" type="email" placeholder="correo@ejemplo.com"></div>
            <div class="field"><label for="du-tel">Teléfono</label>
              <input id="du-tel" placeholder="+54 11 ..."></div>
            <div class="field full"><label for="du-contacto">Otros datos de contacto</label>
              <input id="du-contacto" maxlength="200" placeholder="Dirección, CBU, notas..."></div>
            <div class="field full"><label>Locales de la galería</label>
              <div class="check-grid" id="du-locales"></div>
              <span class="hint">Solo se pueden asignar locales sin dueño. Para pasarle uno que ya tiene dueño, quitáselo primero desde la ficha de ese dueño.</span></div>
          </div>
          <div class="note late" id="du-err" hidden></div>
          <div class="form-actions">
            <button class="btn btn-ghost" onclick="cancelarEdicionDueno()">Cancelar</button>
            <button class="btn btn-primary" onclick="guardarDueno()">Guardar cambios</button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div id="sec-mensajes" role="tabpanel" aria-labelledby="sec-tab-mensajes" hidden>
    <div class="page-head">
      <span class="eyebrow">Mensajes</span>
      <h1>Chats con los locatarios</h1>
      <p>Escribile a un locatario en particular o respondé las consultas que te mandan desde su cuenta.</p>
    </div>

    <div class="chat-cols">
      <section class="panel">
        <div class="panel-head"><h3>Chats abiertos</h3><button class="btn btn-primary btn-sm" onclick="nuevoChat()">Nuevo chat</button></div>
        <div class="chat-list" id="chat-list"></div>
      </section>

      <section class="panel">
        <div class="panel-head"><h3 id="chat-titulo">Conversación</h3><span class="sub" id="chat-sub"></span></div>
        <div class="panel-body">
          <div class="chat-hilo" id="chat-hilo" aria-live="polite">
            <div class="chat-vacio">Elegí un chat de la lista o creá uno nuevo.</div>
          </div>
          <div id="chat-form" hidden>
            <%- include('chat-input') %>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
