<!-- ============ TENANT ============ -->
<main class="wrap view" id="view-tenant" role="tabpanel" aria-labelledby="tab-tenant">
<% if (!tenant) { %>
  <div class="page-head"><h1>Sin contrato vigente</h1><p>Tu usuario no tiene un local con contrato activo. Consultá con la administración.</p></div>
<% } else {
     var u = tenant.unidad;
     var c = tenant.contrato;
     var liq = tenant.liquidacion;
     var det = liq && liq.detalle;
     var deudas = (det && det.deudas) || [];
     var vencido = liq && (liq.saldoAnteriorCents > 0 || liq.diasMora > 0);
     function pct(n) { return Number(n).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '%'; }
%>
  <div class="page-head">
    <span class="eyebrow">Tu cuenta</span>
    <h1><%= u.loc %></h1>
    <p>Esto es lo que te toca pagar este mes por tu local en la <%= estado.galeria.nombre %>, con el detalle de cómo se compone.</p>
  </div>

  <section class="tenant-hero">
    <div class="who">
      <div class="loc">Local <%= u.n %></div>
      <h2><%= u.loc %></h2>
      <div class="meta"><%= u.rubro %> · Contrato #C-<%= String(u.contratoId).padStart(4, '0') %></div>
    </div>
    <div class="due">
      <div class="due-label">Total a pagar — <%= periodoLabel %></div>
      <div class="due-amt"><%= centsToMoney(liq ? liq.totalCents : 0) %></div>
      <div class="due-when<%= vencido ? ' late' : '' %>">
        <% if (deudas.length) { %>
          Incluye deuda de <%= deudas.map(function (d) { return periodoLabelDe(d.periodo); }).join(', ') %> · vence el día <%= c.diaVencimiento %>
        <% } else if (vencido) { %>
          Venció el <%= c.diaVencimiento %>/<%= periodo.split('-')[1] %> · <%= liq.diasMora %> días de atraso
        <% } else { %>
          Vence el día <%= c.diaVencimiento %> del mes
        <% } %>
      </div>
    </div>
  </section>

  <div class="tenant-cols">
    <section class="panel">
      <div class="panel-head"><h3>Detalle de la liquidación</h3><span class="sub"><%= periodoLabel %></span></div>
      <div class="panel-body">
        <% var aum = det && det.alquiler && det.alquiler.aumento; %>
        <table class="liq">
          <tr><td>Alquiler fijo</td><td><%= centsToMoney(liq.alquilerFijoCents) %></td></tr>
          <% if (aum && !aum.falta) { %>
            <tr class="muted"><td>Actualizado <%= pct(aum.pct) %> por <%= aum.indice %> (antes <%= centsToMoney(aum.baseCents) %>)</td><td></td></tr>
          <% } %>
          <tr class="muted"><td>Próxima actualización: <%= c.proximaActualizacion || 'sin fecha' %></td><td></td></tr>
          <% if (liq.variableCents > 0) { %>
            <tr><td>Variable — <%= c.porcentajeFacturacion %>% de facturación declarada</td><td><%= centsToMoney(liq.variableCents) %></td></tr>
            <tr class="muted"><td>Sobre <%= centsToMoney(liq.facturacionDeclaradaCents) %> declarados</td><td></td></tr>
          <% } %>
          <tr><td>Gastos comunes (expensas)</td><td><%= centsToMoney(liq.expensasCents) %></td></tr>
          <% if (det && det.expensas) { %>
            <tr class="muted"><td>
              <% if (det.expensas.pct === null) { %>Tu local no tiene porcentaje de expensas asignado
              <% } else { %><%= pct(det.expensas.pct) %> de <%= centsToMoney(det.expensas.gastosTotalCents) %> de gastos de <%= periodoLabelDe(det.periodoGastos) %> (detalle en el PDF)<% } %>
            </td><td></td></tr>
          <% } %>
          <% if (liq.ajuste) { %>
            <tr class="muted"><td>Incluye <%= liq.ajuste.tipo === 'descuento' ? 'descuento' : 'cargo adicional' %> de <%= centsToMoney(liq.ajuste.montoCents) %><%= liq.ajuste.motivo ? ' · ' + liq.ajuste.motivo : '' %></td><td></td></tr>
          <% } %>
          <% deudas.forEach(function (d) { %>
            <tr><td><%= periodoLabelDe(d.periodo) %> impago · <%= d.meses === 1 ? '1 mes' : d.meses + ' meses' %> de atraso</td><td><%= centsToMoney(d.totalCents) %></td></tr>
            <tr class="muted"><td><%= centsToMoney(d.montoCents) %> × (1 + <%= d.meses %> × <%= pct(det.punitorio.tasaPct) %>) · punitorio <%= centsToMoney(d.punitorioCents) %></td><td></td></tr>
          <% }); %>
          <% if (!deudas.length && liq.saldoAnteriorCents > 0) { %>
            <tr><td>Saldo anterior impago</td><td><%= centsToMoney(liq.saldoAnteriorCents) %></td></tr>
          <% } %>
          <% if (!deudas.length && liq.interesMoraCents > 0) { %>
            <tr><td>Interés por mora<%= liq.diasMora ? ' (' + liq.diasMora + ' días)' : '' %></td><td><%= centsToMoney(liq.interesMoraCents) %></td></tr>
          <% } %>
          <tr class="total"><td>Total a pagar</td><td><%= centsToMoney(liq.totalCents) %></td></tr>
        </table>
        <div class="form-actions" style="margin-top:12px">
          <a class="btn btn-ghost btn-sm" href="/api/liquidaciones/<%= liq.id %>/pdf">Descargar detalle (PDF)</a>
        </div>

        <div id="pay-block" style="margin-top:18px">
          <% if (liq.estado === 'cobrado') { %>
            <div class="note"><strong>Pago acreditado.</strong> No tenés saldo pendiente este mes.</div>
          <% } else if (liq.estado === 'en_revision') { %>
            <div class="note rev"><strong>Comprobante enviado.</strong> Queda en revisión del administrador. Te avisamos cuando se acredite el pago.</div>
          <% } else { %>
            <%# Si le rechazaron el último, el motivo va acá arriba: es donde sube el nuevo. %>
            <% var ultimoRechazo = tenant.comprobantes.find(function (cp) {
                 return cp.periodo === periodo && cp.estado === 'rechazado';
               }); %>
            <% if (ultimoRechazo) { %>
              <div class="note late" style="margin-bottom:14px">
                <strong>Te rechazaron el comprobante anterior.</strong>
                <%= ultimoRechazo.motivoRechazo ? ultimoRechazo.motivoRechazo : 'Consultá con la administración.' %>
                Subí uno nuevo.
              </div>
            <% } %>
            <label class="filebox" for="t-comp" id="t-comp-box">
              <div class="fi-ico">🧾</div><div class="fi-t" id="t-comp-t">Subir comprobante de pago</div><div class="fi-s">Transferencia · imagen o PDF</div>
            </label>
            <input type="file" id="t-comp" accept="image/*,application/pdf" onchange="tenantUpload(this)">
            <div class="note late" id="t-err" hidden></div>
            <div class="form-actions">
              <button class="btn btn-primary" id="t-send" disabled onclick="tenantSend(<%= liq.id %>)">Enviar comprobante</button>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <div style="display:grid;gap:20px">
      <section class="panel">
        <div class="panel-head"><h3>Tu contrato</h3></div>
        <div class="panel-body">
          <dl class="dl">
            <dt>Modalidad</dt><dd><%= c.modalidad %></dd>
            <dt>Inicio</dt><dd><%= c.inicio %></dd>
            <dt>Plazo</dt><dd><%= c.plazoMeses %> meses</dd>
            <dt>Actualización</dt><dd><%= c.indice %> · <%= (estado.config && estado.config.frecuencia) || '—' %></dd>
            <dt>Próxima actualización</dt><dd><%= c.proximaActualizacion || '—' %></dd>
            <dt>Vencimiento mensual</dt><dd>Día <%= c.diaVencimiento %></dd>
          </dl>
        </div>
      </section>
    </div>
  </div>

  <section class="panel" style="margin-top:20px" id="tenant-cuenta">
    <div class="panel-head"><h3>Cuenta corriente</h3><span class="sub">Tus liquidaciones mes a mes</span></div>
    <div class="panel-body" style="overflow-x:auto">
      <table class="hist">
        <thead><tr><th>Período</th><th>Del mes</th><th>Deuda ant.</th><th>Total</th><th>Estado</th><th></th></tr></thead>
        <tbody>
          <% tenant.cuenta.forEach(function (p) { %>
            <tr>
              <td class="desc"><%= periodoLabelDe(p.periodo) %></td>
              <td><%= centsToMoney(p.delMesCents) %></td>
              <td><%= centsToMoney(p.deudaAnteriorCents) %></td>
              <td><%= centsToMoney(p.totalCents) %></td>
              <td>
                <% if (p.cobradoCents >= p.totalCents && p.totalCents > 0) { %><span class="st-tag pagado">Pagado</span>
                <% } else if (p.trasladada) { %><span class="st-tag mora">Pasó al mes siguiente</span>
                <% } else if (p.estado === 'en_revision') { %><span class="st-tag pend">En revisión</span>
                <% } else { %><span class="st-tag pend">Pendiente</span><% } %>
              </td>
              <td><a class="btn btn-ghost btn-sm" href="/api/liquidaciones/<%= p.id %>/pdf">PDF</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="chat-intro" style="margin-top:10px">Si un mes queda impago, su monto pasa al siguiente con un punitorio por cada mes de atraso.</p>
    </div>
  </section>

  <section class="panel" style="margin-top:20px" id="tenant-comprobantes">
    <div class="panel-head"><h3>Mis comprobantes</h3><span class="sub">Los que subiste a la administración</span></div>
    <div class="panel-body" style="overflow-x:auto">
      <% if (!tenant.comprobantes.length) { %>
        <p class="chat-intro">Todavía no subiste comprobantes.</p>
      <% } else { %>
        <table class="hist">
          <thead><tr><th>Período</th><th>Subido el</th><th>Archivo</th><th>Estado</th><th></th></tr></thead>
          <tbody>
            <% tenant.comprobantes.forEach(function (cp) { %>
              <tr>
                <td class="desc"><%= periodoLabelDe(cp.periodo) %></td>
                <td><%= cp.fecha %></td>
                <td class="desc"><%= cp.archivoNombre || '—' %></td>
                <td>
                  <% if (cp.estado === 'aceptado') { %><span class="st-tag pagado">Aceptado</span>
                  <% } else if (cp.estado === 'rechazado') { %>
                    <span class="st-tag mora">Rechazado</span>
                    <% if (cp.motivoRechazo) { %>
                      <div class="desc" style="color:var(--muted);margin-top:4px"><%= cp.motivoRechazo %></div>
                    <% } %>
                  <% } else { %><span class="st-tag pend">En revisión</span><% } %>
                </td>
                <td>
                  <% if (cp.tieneArchivo) { %>
                    <a class="btn btn-ghost btn-sm" href="/api/comprobantes/<%= cp.id %>/archivo">Descargar</a>
                  <% } else { %>
                    <span class="desc" style="color:var(--muted)">Sin archivo</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </section>

  <section class="panel" style="margin-top:20px" id="tenant-chat">
    <div class="panel-head"><h3>Mensajes con la administración</h3><span class="sub"><%= estado.galeria.nombre %></span></div>
    <div class="panel-body">
      <div id="tc-vacio">
        <p class="chat-intro">¿Tenés una consulta? Escribile a la administración de la galería desde acá.</p>
        <div class="note late" id="tc-err" hidden></div>
        <div class="form-actions"><button class="btn btn-primary" onclick="contactarAdministracion()">Contactar a la administración</button></div>
      </div>
      <div id="tc-chat" hidden>
        <div class="chat-hilo" id="chat-hilo" aria-live="polite"></div>
        <%- include('chat-input') %>
      </div>
    </div>
  </section>

  <section class="panel" style="margin-top:20px">
    <div class="panel-head"><h3>Gastos de la galería · <%= periodoLabel %></h3><span class="sub">Los del mes en curso: se reparten en las expensas del mes que viene</span></div>
    <div class="panel-body" style="overflow-x:auto">
      <table class="hist" id="tenant-gastos-table">
        <thead><tr><th>Tipo</th><th>Proveedor</th><th>Descripción</th><th>Factura</th><th style="text-align:right">Monto</th><th>Adjunto</th></tr></thead>
        <tbody id="tenant-gastos-rows"></tbody>
      </table>
    </div>
  </section>
<% } %>
</main>
